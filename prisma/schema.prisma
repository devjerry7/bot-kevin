generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vip {
  userId          String      @id @unique
  tier            String      @default("default")
  since           DateTime    @default(now())
  expiresAt       DateTime?
  customRoleId    String?
  customChannelId String?
  friends         VipFriend[]
}

model VipFriend {
  friendId String @id @unique
  ownerId  String
  owner    Vip    @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
}

model Pd {
  memberId String   @id @unique
  staffId  String
  since    DateTime @default(now())
}

model Panela {
  userId String @id @unique
}

model Blacklist {
  userId String @id @unique
}

model Booster {
  userId          String          @id @unique
  since           DateTime        @default(now())
  customRoleId    String?
  customChannelId String?
  friends         BoosterFriend[]
}

model BoosterFriend {
  friendId String  @id @unique
  ownerId  String
  owner    Booster @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
}

model Economy {
  userId    String    @id @unique
  wallet    Int       @default(0)
  bank      Int       @default(0)
  lastDaily DateTime?
  lastWork  DateTime?
}

model Inventory {
  id       Int    @id @default(autoincrement())
  userId   String
  itemId   String
  quantity Int    @default(1)

  @@unique([userId, itemId])
}

// ==========================================
// 🏢 CONFIGURAÇÃO DO SERVIDOR (SINGLE-SERVER)
// ==========================================
model ServerConfig {
  id        String   @id @default("main")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- 🎨 IDENTIDADE & APARÊNCIA ---
  prefix         String  @default("k!")
  embedColor     String  @default("#2f3136")
  bannerImage    String?
  thumbnailImage String?
  
  // --- 💰 ECONOMIA ---
  currencyName  String  @default("Coins")
  currencyEmoji String  @default("💵")

  // --- 👋 BOAS-VINDAS & SAÍDA ---
  welcomeChannelId String?
  welcomeMessage   String?
  welcomeImage     String?
  leaveChannelId   String?

  // --- 🛡️ PERMISSÕES & STAFF ---
  staffTrustedRoles String?
  roleManagerIds    String? 
  roleAssignerIds   String?

  // --- ✅ SISTEMA DE VERIFICAÇÃO ---
  verificationChannelId    String?
  approvalChannelId        String?
  approvedLogChannelId     String?
  verifiedRoleId           String?
  approverRoleId           String?
  secondaryApproverRoleId  String?

  verificationTitle        String?  @default("🔐 Verificação Necessária")
  verificationDescription  String?  @default("Clique no botão abaixo para iniciar seu processo de verificação.")
  verificationImage        String?

  // --- 💎 SISTEMA VIP ---
  vipRoleId       String?
  vipCategoryId   String?
  vipAnchorRoleId String?

  // --- 👮 MODERAÇÃO & PROTEÇÃO ---
  jailRoleId     String?
  pdLogChannelId String?
  panelaLogId    String?
  blacklistLogId String?

  // --- 📝 LOGS DE AUDITORIA ---
  logChannelId         String?
  voiceLogId           String?
  messageDeleteLogId   String?
  messageEditLogId     String?
  modBanLogId          String?
  modMuteLogId         String?
  memberJoinLeaveLogId String?
  channelUpdateLogId   String?
  
  // --- 🎫 TICKETS ---
  ticketLogId           String?
  ticketParentChannelId String?

  // --- 🎮 JOGOS & BOOSTERS ---
  freefireRoleId    String?
  valorantRoleId    String?
  csRoleId          String?
  robloxRoleId      String?
  gtaRoleId         String?
  minecraftRoleId   String?
  boosterCategoryId    String?
  boosterAnchorRoleId  String?

  // --- 🎭 REACTION ROLES (LEGADO) ---
  roleReactionChannelId String?
  roleReactionMessageId String?

  // --- 🔴 SISTEMA DE LIVES ---
  liveNotificationChannelId String?
  liveNotificationRoleId    String?
  liveSystemEnabled         Boolean @default(true)
}

// ==========================================
// 🔴 SISTEMA MULTIPLATAFORMA DE LIVES
// ==========================================

model Streamer {
  id            String             @id @default(uuid())
  displayName   String
  discordUserId String?            // Opcional: linkar com a conta do membro no Discord
  enabled       Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  platforms     StreamerPlatform[]
}

model StreamerPlatform {
  id               String        @id @default(uuid())
  streamerId       String
  streamer         Streamer      @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  platform         String        // "twitch", "tiktok", "kick", "youtube"
  platformUserId   String        // ID interno da API
  platformUsername String        // Nome de usuário (ex: @fulano)
  enabled          Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  sessions         LiveSession[]

  // Trava de segurança: Um streamer só pode ter UMA conta ativa por plataforma
  @@unique([streamerId, platform]) 
}

model FfTournament {
  id          String   @id @default("main")
  isOpen      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model FfParticipant {
  userId      String   @id @unique
  username    String
  registeredAt DateTime @default(now())
}

model FfTeam {
  id          String   @id @default(uuid())
  teamName    String
  player1Id   String
  player2Id   String
  channelId   String?  // ID da call temporária de voz
  seed        Int      @default(0)
}

model FfMatch {
  id          String   @id @default(uuid())
  round       Int      // 1 = Quartas/Oitavas, 2 = Semifinal, 3 = Final
  teamAId     String?
  teamBId     String?
  winnerId    String?
  messageId   String?  // ID da mensagem do painel de votação/vitória
  status      String   @default("pending") // pending, ongoing, finished
}

model LiveSession {
  id               String           @id @default(uuid())
  platformId       String
  platform         StreamerPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  externalLiveId   String           // ID único da live gerado pela plataforma
  isActive         Boolean          @default(true)
  discordMessageId String?          // ID da notificação enviada no chat
  startedAt        DateTime         @default(now())
  endedAt          DateTime?

  // A GRANDE MÁGICA ANTI-DUPLICAÇÃO: 
  @@unique([platformId, externalLiveId]) 
}

// ==========================================
// 🛡️ SISTEMA DE GESTÃO DE STAFF (2QN)
// ==========================================

model StaffConfig {
  id                    String   @id @default("main")
  metaChatSemanal       Int      @default(250)
  metaCallMinutos       Int      @default(600) // 10 horas em minutos
  
  // Cargos de Trilha e Visuais (IDs do Discord)
  roleTraineeChat       String?
  roleOficialChat       String?
  roleVeteranoChat      String?
  roleEliteChat         String?

  roleTraineeCall       String?
  roleOficialCall       String?
  roleVeteranoCall      String?
  roleEliteCall         String?

  // Cargos de Permissão [P] Backend
  rolePermChatLvl2      String?
  rolePermChatLvl3      String?
  rolePermCallLvl2      String?
  rolePermCallLvl3      String?
}

model StaffUser {
  discordId    String        @id
  trackType    String        // 'CHAT' ou 'CALL'
  currentRank  Int           @default(1) // 1: Trainee, 2: Oficial, 3: Veterano, 4: Elite
  streakWeeks  Int           @default(0)
  warnings     Int           @default(0)
  status       String        @default("ACTIVE") // 'ACTIVE' ou 'PAUSED'
  createdAt    DateTime      @default(now())
  tracking     StaffTracking?
}

model StaffTracking {
  discordId     String    @id
  user          StaffUser @relation(fields: [discordId], references: [discordId], onDelete: Cascade)
  msgCount      Int       @default(0)
  voiceMinutes  Int       @default(0)
  lastVoiceJoin DateTime?
}