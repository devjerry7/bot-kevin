generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vip {
  userId          String      @id @unique
  tier            String      @default("default")
  since           DateTime    @default(now())
  expiresAt       DateTime?
  customRoleId    String?
  customChannelId String?
  friends         VipFriend[]
}

model VipFriend {
  friendId String @id @unique
  ownerId  String
  owner    Vip    @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
}

model Pd {
  memberId String   @id @unique
  staffId  String
  since    DateTime @default(now())
}

model Panela {
  userId String @id @unique
}

model Blacklist {
  userId String @id @unique
}

model Booster {
  userId          String          @id @unique
  since           DateTime        @default(now())
  customRoleId    String?
  customChannelId String?
  friends         BoosterFriend[]
}

model BoosterFriend {
  friendId String  @id @unique
  ownerId  String
  owner    Booster @relation(fields: [ownerId], references: [userId], onDelete: Cascade)
}

model Economy {
  id        Int       @id @default(autoincrement())
  userId    String
  guildId   String
  wallet    Int       @default(0)
  bank      Int       @default(0)
  lastDaily DateTime?
  lastWork  DateTime?

  @@unique([userId, guildId])
}

model Inventory {
  id       Int    @id @default(autoincrement())
  userId   String
  guildId  String
  itemId   String
  quantity Int    @default(1)

  @@unique([userId, guildId, itemId])
}

// ==========================================
// 🏢 CONFIGURAÇÃO DO SERVIDOR (SAAS)
// ==========================================
model GuildConfiguration {
  id        String   @id @default(uuid())
  guildId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- 🎨 IDENTIDADE & APARÊNCIA ---
  prefix         String  @default("k!")
  embedColor     String  @default("#2f3136")
  bannerImage    String?
  thumbnailImage String?
  
  // --- 💰 ECONOMIA ---
  currencyName  String  @default("Coins")
  currencyEmoji String  @default("💵")

  // --- 👋 BOAS-VINDAS & SAÍDA ---
  welcomeChannelId String?
  welcomeMessage   String?
  welcomeImage     String?
  leaveChannelId   String?

  // --- 🛡️ PERMISSÕES & STAFF ---
  staffTrustedRoles String?
  roleManagerIds    String? 
  roleAssignerIds   String?

  // --- ✅ SISTEMA DE VERIFICAÇÃO ---
  verificationChannelId    String?
  approvalChannelId        String?
  approvedLogChannelId     String?
  verifiedRoleId           String?
  approverRoleId           String?
  secondaryApproverRoleId  String?

  // 👇 --- ADICIONE ESTAS 3 LINHAS AQUI --- 👇
  verificationTitle        String?  @default("🔐 Verificação Necessária")
  verificationDescription  String?  @default("Clique no botão abaixo para iniciar seu processo de verificação.")
  verificationImage        String?

  // --- 💎 SISTEMA VIP ---
  vipRoleId       String?
  vipCategoryId   String?
  vipAnchorRoleId String?

  // --- 👮 MODERAÇÃO & PROTEÇÃO ---
  jailRoleId     String?
  pdLogChannelId String?
  panelaLogId    String?
  blacklistLogId String?

  // --- 📝 LOGS DE AUDITORIA ---
  logChannelId         String?
  voiceLogId           String?
  messageDeleteLogId   String?
  messageEditLogId     String?
  modBanLogId          String?
  modMuteLogId         String?
  memberJoinLeaveLogId String?
  channelUpdateLogId   String?
  
  // --- 🎫 TICKETS ---
  ticketLogId           String?
  ticketParentChannelId String?

  // --- 🎮 JOGOS & BOOSTERS ---
  freefireRoleId    String?
  valorantRoleId    String?
  csRoleId          String?
  robloxRoleId      String?
  gtaRoleId         String?
  minecraftRoleId   String?
  boosterCategoryId    String?
  boosterAnchorRoleId  String?

  // --- 🎭 REACTION ROLES (LEGADO) ---
  roleReactionChannelId String?
  roleReactionMessageId String?

  @@map("guild_configurations")
}